// ============================================================
// 📊 TRADE LOGGER - Auto Log Trades to Google Sheets
// ============================================================
// This indicator lets you manually place trades on your chart
// and automatically sends Entry, SL, TP1, TP2, TP3 via webhook
// to your Google Sheet or server.
//
// HOW TO USE:
// 1. Add this indicator to your chart
// 2. Set your webhook URL in the alert settings
// 3. Draw your trade levels using the input fields
// 4. When you trigger a trade, an alert fires with all data
// ============================================================

//@version=5
indicator("Trade Logger - Backtest", overlay=true)

// ============================================================
// INPUTS
// ============================================================

// Trade Direction
tradeDirection = input.string("SELL", "Trade Direction", options=["BUY", "SELL"])

// Price Levels - Set these for each trade
entryPrice = input.float(0.0, "Entry Price", step=0.01)
slPrice = input.float(0.0, "Stop Loss (SL)", step=0.01)
tp1Price = input.float(0.0, "TP1 (R1.1)", step=0.01)
tp2Price = input.float(0.0, "TP2 (R1.2)", step=0.01)
tp3Price = input.float(0.0, "TP3 (R1.3)", step=0.01)

// Visual Settings
showLevels = input.bool(true, "Show Levels on Chart")
entryColor = input.color(color.blue, "Entry Color")
slColor = input.color(color.red, "SL Color")
tpColor = input.color(color.green, "TP Color")

// Alert Trigger
triggerAlert = input.bool(false, "🚨 Trigger Alert (toggle to send)")

// ============================================================
// CALCULATIONS
// ============================================================

risk = math.abs(entryPrice - slPrice)
reward1 = math.abs(entryPrice - tp1Price)
reward2 = math.abs(entryPrice - tp2Price)
reward3 = math.abs(entryPrice - tp3Price)

rr1 = risk > 0 ? math.round(reward1 / risk, 2) : 0
rr2 = risk > 0 ? math.round(reward2 / risk, 2) : 0
rr3 = risk > 0 ? math.round(reward3 / risk, 2) : 0

// ============================================================
// DRAW LEVELS ON CHART
// ============================================================

if showLevels and entryPrice > 0
    // Entry line
    line.new(bar_index - 20, entryPrice, bar_index, entryPrice, 
             color=entryColor, width=2, style=line.style_solid)
    label.new(bar_index, entryPrice, "Entry: " + str.tostring(entryPrice), 
              color=entryColor, textcolor=color.white, size=size.small)

    // SL line
    if slPrice > 0
        line.new(bar_index - 20, slPrice, bar_index, slPrice, 
                 color=slColor, width=2, style=line.style_dashed)
        label.new(bar_index - 5, slPrice, "SL: " + str.tostring(slPrice), 
                  color=slColor, textcolor=color.white, size=size.small)

    // TP1 line
    if tp1Price > 0
        line.new(bar_index - 20, tp1Price, bar_index, tp1Price, 
                 color=tpColor, width=1, style=line.style_dotted)
        label.new(bar_index - 10, tp1Price, "R1.1: " + str.tostring(tp1Price) + " (RR:" + str.tostring(rr1) + ")", 
                  color=tpColor, textcolor=color.white, size=size.small)

    // TP2 line
    if tp2Price > 0
        line.new(bar_index - 20, tp2Price, bar_index, tp2Price, 
                 color=tpColor, width=1, style=line.style_dotted)
        label.new(bar_index - 10, tp2Price, "R1.2: " + str.tostring(tp2Price) + " (RR:" + str.tostring(rr2) + ")", 
                  color=tpColor, textcolor=color.white, size=size.small)

    // TP3 line
    if tp3Price > 0
        line.new(bar_index - 20, tp3Price, bar_index, tp3Price, 
                 color=tpColor, width=1, style=line.style_dotted)
        label.new(bar_index - 10, tp3Price, "R1.3: " + str.tostring(tp3Price) + " (RR:" + str.tostring(rr3) + ")", 
                  color=tpColor, textcolor=color.white, size=size.small)

// ============================================================
// ALERT WITH JSON PAYLOAD (for webhook)
// ============================================================

// This alert fires when you toggle "Trigger Alert" to true
if triggerAlert and barstate.islast
    alertMessage = '{"pair":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","direction":"' + tradeDirection + '","entry":' + str.tostring(entryPrice) + ',"sl":' + str.tostring(slPrice) + ',"tp1":' + str.tostring(tp1Price) + ',"tp2":' + str.tostring(tp2Price) + ',"tp3":' + str.tostring(tp3Price) + ',"risk":' + str.tostring(math.round(risk, 2)) + ',"rr1":' + str.tostring(rr1) + ',"rr2":' + str.tostring(rr2) + ',"rr3":' + str.tostring(rr3) + ',"time":"' + str.tostring(time) + '"}'
    alert(alertMessage, alert.freq_once_per_bar)

// ============================================================
// TABLE - Show trade info on chart
// ============================================================

var table infoTable = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80))

if barstate.islast and entryPrice > 0
    table.cell(infoTable, 0, 0, "Trade Info", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, tradeDirection, text_color=tradeDirection == "BUY" ? color.green : color.red, text_size=size.normal)
    
    table.cell(infoTable, 0, 1, "Entry", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(entryPrice), text_color=entryColor, text_size=size.small)
    
    table.cell(infoTable, 0, 2, "SL", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(slPrice), text_color=slColor, text_size=size.small)
    
    table.cell(infoTable, 0, 3, "TP1 (R1.1)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(tp1Price) + " | RR: " + str.tostring(rr1), text_color=tpColor, text_size=size.small)
    
    table.cell(infoTable, 0, 4, "TP2 (R1.2)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(tp2Price) + " | RR: " + str.tostring(rr2), text_color=tpColor, text_size=size.small)
    
    table.cell(infoTable, 0, 5, "TP3 (R1.3)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(tp3Price) + " | RR: " + str.tostring(rr3), text_color=tpColor, text_size=size.small)
    
    table.cell(infoTable, 0, 6, "Risk", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(math.round(risk, 2)) + " pips", text_color=color.yellow, text_size=size.small)
